{
  "name": "@jieqi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --log-level=warning",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jieqi/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  }
}
