# 宝塔 Nginx 站点配置示例(静态 + WSS 反代)
# 前提:域名已解析到服务器,TLS 证书已在宝塔申请(或用 certbot)
# 项目目录约定:/www/wwwroot/jieqi/{web/dist, server/dist/server.js}

server {
    listen 80;
    server_name jq.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name jq.example.com;

    # 宝塔申请的证书路径(按实际改)
    ssl_certificate     /www/server/panel/vhost/cert/jq.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/jq.example.com/privkey.pem;

    # 前端静态
    root /www/wwwroot/jieqi/web/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # WebSocket 反代到 Node 服务
    location /ws {
        proxy_pass http://127.0.0.1:3190;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /healthz {
        proxy_pass http://127.0.0.1:3190;
    }
}
