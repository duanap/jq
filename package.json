{
  "name": "jieqi",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w server run build && npm -w web run build",
    "start": "node server/dist/server.cjs",
    "test": "npm -w shared run test",
    "e2e": "npm -w server run e2e",
    "typecheck": "npm -w shared run typecheck && npm -w server run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
